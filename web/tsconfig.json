{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["@rsbuild/core/types", "node"]
  },
  "include": ["src", "rsbuild.config.ts", ".storybook"],
  "exclude": ["node_modules", "dist", "storybook-static", "**/*.test.js"]
}
