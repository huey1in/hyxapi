# 端口号
# PORT=3000
# 首页暂未完成设计，/ 跳转 /console；登录、控制台和模型使用同一站点。
# 页面限流与真实存在的前端静态文件分别计数，静态文件限流默认关闭。
# GLOBAL_WEB_RATE_LIMIT_ENABLE=true
# GLOBAL_WEB_RATE_LIMIT=60
# GLOBAL_WEB_RATE_LIMIT_DURATION=180
# GLOBAL_STATIC_RATE_LIMIT_ENABLE=false
# GLOBAL_STATIC_RATE_LIMIT=1000
# GLOBAL_STATIC_RATE_LIMIT_DURATION=180


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=hyxapi
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# ClickHouse 仅用于日志，主数据库仍使用 SQLite/MySQL/PostgreSQL
# LOG_SQL_DSN=clickhouse://default:password@127.0.0.1:9000/logs
# HTTPS 地址默认启用 TLS；自动清理仅作用于使用日志，不影响审计日志
# LOG_SQL_CLICKHOUSE_TTL_DAYS=0
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 仅在确认旧钱包字段已能安全存储 64 位余额时跳过启动检查
# SKIP_64BIT_QUOTA_SCHEMA_CHECK=false


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 等待上游响应头的最长秒数；不限制已开始的流式响应，0 表示禁用。
# RELAY_RESPONSE_HEADER_TIMEOUT=1800
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# 会话密钥
# SESSION_SECRET=random_string
# HTTPS 部署设置为 true，并填写刷新 Cookie 允许使用的公开站点 Origin。
# 本地 HTTP 开发保持 false；不再设置跨域 Cookie 或独立首页域名。
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://your-site.example
# 可选：密码登录时使用服务端公钥加密；密钥持久化到数据库。
# PASSWORD_LOGIN_ENCRYPTION_ENABLED=false
# 每个账户的设备会话上限与每日签发上限。
# USER_SESSION_ACTIVE_LIMIT=50
# USER_SESSION_ISSUANCE_LIMIT=100
# USER_SESSION_ISSUANCE_WINDOW_SECONDS=86400
# USER_SESSION_REVOKED_RETENTION_DAYS=7
# USER_SESSION_HOURLY_ALERT_THRESHOLD=5000

# SMTP 显式 STARTTLS；默认验证服务器证书。
# SMTP_STARTTLS_ENABLED=false
# SMTP_INSECURE_SKIP_VERIFY=false

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master
# Optional interface to bind the API; empty listens on all interfaces.
# BIND_ADDRESS=127.0.0.1

# Docker Compose 部署（宿主机端口，与容器内固定 3000 分开）
# HYXAPI_IMAGE=ghcr.io/huey1in/hyxapi:latest
# HYXAPI_PORT=3000
# HYXAPI_BIND_ADDRESS=127.0.0.1
# 根目录 docker-compose.yml 使用 PostgreSQL + Redis；新部署分别生成随机密码。
# 保留已有数据库密码，密码包含特殊字符时需正确编码连接字符串。
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
